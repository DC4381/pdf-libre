// Ressources Windows : icône de l'exécutable et informations de version.
#include <winver.h>

IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/resources/app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040c04b0"
        BEGIN
            VALUE "CompanyName", "David Carmo"
            VALUE "FileDescription", "PDF Libre - lecteur PDF"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "PDFLibre"
            VALUE "LegalCopyright", "Copyright (C) 2026 David Carmo. Licence AGPL-3.0"
            VALUE "OriginalFilename", "PDFLibre.exe"
            VALUE "ProductName", "PDF Libre"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x040c, 1200
    END
END
